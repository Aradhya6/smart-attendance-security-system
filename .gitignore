# =============================================================================
# Smart Attendance & Security System — .gitignore (Phase 2 hardened)
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environment ---
.venv/
venv/
ENV/
env/

# --- Secrets / Environment variables ---
.env
.env.*
!.env.example

# --- IDEs ---
.idea/
.vscode/
*.swp
*.swo

# --- Testing & Coverage ---
.pytest_cache/
.coverage
htmlcov/

# --- Database / Storage ---
*.sqlite3
*.db

# --- Biometric & recorded data (NEVER commit) ---
data/
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/**/*.bmp
recordings/
uploads/
faces/
tests/fixtures_local/
tests/fixtures_local/**/*.jpg
tests/fixtures_local/**/*.jpeg
tests/fixtures_local/**/*.png
tests/fixtures_local/**/*.bmp

# --- Video files ---
*.mp4
*.avi
*.mkv
*.mov
*.wmv

# --- Model weights & cache (NEVER commit) ---
*.pt
*.pth
*.onnx
*.pb
*.tflite
models/weights/
weights/
.insightface/

# --- Logs ---
*.log
logs/

# --- Streamlit ---
.streamlit/secrets.toml

# --- OS ---
.DS_Store
Thumbs.db
