# ==============================================================================
# Smart Attendance and Security System - Environment Configuration
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Backend API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_attendance
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async URL for SQLAlchemy async engine
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_attendance
# Sync URL for Alembic migrations
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_attendance

# --- Redis (Cache & Pub/Sub) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Streamlit Dashboard ---
DASHBOARD_PORT=8501
BACKEND_API_URL=http://localhost:8000/api/v1

# --- AI & Hardware Acceleration (CPU default, GPU flexible) ---
# Options: cpu | cuda
DEVICE=cpu
# Options: CPUExecutionProvider | CUDAExecutionProvider
ONNX_PROVIDER=CPUExecutionProvider
# Model selection: buffalo_s (MobileFaceNet - CPU friendly) | buffalo_l (ResNet-100 - GPU recommended)
INSIGHTFACE_MODEL_NAME=buffalo_s
YOLO_MODEL_PATH=yolov8n-face.pt

# --- Recognition & Detection Thresholds ---
# Spec-defined cosine similarity match threshold
FACE_MATCH_THRESHOLD=0.50
FACE_DETECTION_CONFIDENCE=0.60
DEDUPLICATION_COOLDOWN_SECONDS=1800

# --- Camera & Stream Configuration ---
# Frame processing stride (process every Nth frame, e.g. 5 = 6 fps from 30 fps)
FRAME_SAMPLE_INTERVAL=5
# Comma-separated RTSP URLs or webcam index (e.g. 0 for local webcam testing)
DEFAULT_CAMERA_SOURCE=0
